/// Helps categorize Transaction Descriptions that might be too vague and end up falling in the incorrect categories.
/// 
/// Requires manual input but helps clean up the data since the data from the bank is at a higher grain level.
table CategoryOverrides
	lineageTag: 87a1deb4-55fc-4972-93c0-67e8ec744619

	column Category
		dataType: string
		lineageTag: 9d5bad67-0dc0-4a69-84a2-6b3e963fea38
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column 'Transaction Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: d619f67b-d722-4b1e-920a-6b0f487c8bd4
		summarizeBy: none
		sourceColumn: Transaction Date

		variation Variation
