	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fnAssignCategory =
		let
		    fnAssignCategory = (description as text) =>
		    let
		        upperDesc = Text.Upper(description),
		
		        // Filter CategoryMap for any keyword found in the description
		        matchedRows = Table.SelectRows(
		            CategoryMap,
		            each Text.Contains(upperDesc, Text.Upper([Keyword]))
		        ),
		
		        // Sort by Priority so specific matches (1) beat catch-alls (2)
		        sortedMatches = Table.Sort(matchedRows, {{"Priority", Order.Ascending}}),
		
		        // Return the first match or "Uncategorized"
		        result = if Table.RowCount(sortedMatches) > 0
		                 then sortedMatches{0}[Category]
		                 else "Uncategorized"
		    in
		        result
		in
		    fnAssignCategory
	lineageTag: febccf17-1e0d-4aab-80ec-7c7141449047

